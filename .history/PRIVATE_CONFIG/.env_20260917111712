# OKPORA PRIVATE CONFIGURATION CENTER
# Copy to the project root as .env ONLY for local setup.
# Production values belong in Netlify -> Project configuration -> Environment variables.
# Never prefix a secret with VITE_. Never commit real values.

# REQUIRED: PostgreSQL pooler connection string; percent-encode password special characters.
DATABASE_URL= postgresql://postgres.aptritlvzeellpoxhtqx:Successokpora1.@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Optional trusted database CA certificate in PEM; literal \n supported. TLS verification stays enabled.
DATABASE_CA_CERT=
# Required in production, exact origin, no trailing slash or path.
SITE_URL=https://your-okpora-site.netlify.app

# PAYMENT: choose one. Do not fill every provider.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# v3 uses verif-hash (legacy). hmac explicitly uses flutterwave-signature SHA256 base64.
FLUTTERWAVE_WEBHOOK_MODE=legacy
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EMAIL: Resend is the implemented transactional email adapter.
RESEND_API_KEY=
EMAIL_FROM=
# Optional private destination for paid-order email alerts; in-app alerts always work.
ADMIN_NOTIFICATION_EMAIL=

# OPTIONAL STORAGE: Supabase Storage, only needed for dashboard image uploads.
SUPABASE_URL=SUPABASE_URL=https://aptritlvzeellpoxhtqx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=product-images

# OPTIONAL first-admin CLI convenience. It does not create or grant access by itself.
ADMIN_EMAIL=

# PUBLIC browser configuration only (build scope). Most store content is edited in Admin.
VITE_SITE_URL=
VITE_STORE_NAME=Okpora
VITE_GOOGLE_ANALYTICS_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

